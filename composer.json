{
  "name": "growtask/simflex-core",
  "description": "Core of Simflex CMS",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "keywords": [
    "php",
    "simflex",
    "simflex-core",
    "simflex-cms"
  ],
  "homepage": "https://github.com/growtask/simflex-core",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Denis Glushkov",
      "email": "amkarovec@gmail.com",
      "homepage": "https://github.com/glushkovds"
    },
    {
      "name": "pf",
      "homepage": "https://pff.su"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-gd": "*",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-intl": "*",
    "psr/log": "*",
    "maximebf/debugbar": "^1.22",
    "filp/whoops": "^2.15",
    "phpmailer/phpmailer": "^6.0",
    "curl/curl": "^2.0",
    "scssphp/scssphp": "^1.11",
    "tubalmartin/cssmin": "^4.1",
    "vlucas/phpdotenv": "^5.4"
  },
  "require-dev": {},
  "suggest": {},
  "autoload": {
    "psr-4": {
      "Simflex\\Core\\": "src"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "4.0.x-dev"
    }
  }
}
