{
  "name": "growtask/simflex",
  "description": "Core for Simflex",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "keywords": [
    "php",
    "simplex-core",
    "simplex-cms",
    "simflex",
    "simflex-core",
    "simflex-cms"
  ],
  "homepage": "https://github.com/growtask/simflex",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Denis Glushkov",
      "email": "amkarovec@gmail.com",
      "homepage": "https://github.com/glushkovds"
    },
    {
      "name": "pf",
      "homepage": "https://pff.su"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-gd": "*",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "psr/log": "*",
    "maximebf/debugbar": "1.22.*",
    "filp/whoops": "2.15.*",
    "phpmailer/phpmailer": "v6.*",
    "curl/curl": "2.*",
    "scssphp/scssphp": "^1.11",
    "tubalmartin/cssmin": "^4.1",
    "vlucas/phpdotenv": "^5.4"
  },
  "require-dev": {
  },
  "suggest": {
  },
  "autoload": {
    "psr-4": {
      "Simflex\\": "src"
    },
    "files": [
      "src/constants.php",
      "src/functions.php"
    ]
  }
}
